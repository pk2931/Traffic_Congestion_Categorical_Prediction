    {
      "cell_type": "markdown",
      "source": [
        "Categorical target"
      ],
      "metadata": {
        "id": "GEhcqiyqouKN"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Categorize target\n",
        "max_value = df['Traffic_Volume'].max()\n",
        "split_1, split_2 = max_value / 3, max_value * 2 / 3\n",
        "df['Traffic_Level'] = pd.cut(df['Traffic_Volume'], bins=[0, split_1, split_2, np.inf], labels=[0, 1, 2])\n",
        "\n",
        "# Drop NaN\n",
        "df = df.dropna(subset=['Traffic_Level'])\n",
        "\n",
        "# Drop Segment_ID and Traffic_Volume\n",
        "df.drop(columns=['Segment_ID', 'Traffic_Volume'], inplace=True)\n",
        "\n",
        "X = df.drop(columns=['Traffic_Level'])\n",
        "y = df['Traffic_Level'].astype(int)\n",
        "\n",
        "X.shape, y.shape"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
